# Copy to deploy/.env on the server. Do not commit the real file.
DOMAIN=gymtrack.example.com
ACME_EMAIL=owner@example.com
APP_VERSION=local
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Preserve the existing Neon URL, including its TLS query parameters.
# Use the connection string from Neon; this placeholder is not usable.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST.neon.tech/REPLACE_DATABASE?sslmode=require
DATABASE_SSL=true

# Keep the working email provider during the first migration.
# SES is not implemented in the app yet.
MAIL_TRANSPORT=brevo
MAIL_API_KEY=REPLACE_WITH_EXISTING_PROVIDER_KEY
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
MAIL_FROM_NAME=GymTrack
RESET_TOKEN_HOURS=1
VERIFY_TOKEN_HOURS=24
